# Supabase — create a project at https://supabase.com and copy from Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Site URL for auth email redirects (Vercel production URL or http://localhost:3000)
NEXT_PUBLIC_SITE_URL=http://localhost:3000
