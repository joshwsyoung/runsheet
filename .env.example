# Supabase — create a project at https://supabase.com and copy from Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Fallback when no browser request Host is present (cron, CLI). Prefer matching your real browser origin.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# No leading/trailing spaces — if present, Supabase recovery links get redirect_to=%20https://… and fail (403).

# Auth emails require these in Supabase → Authentication → URL Configuration:
#   Site URL — e.g. http://localhost:3002 (whatever you type in the address bar locally)
#   Redirect URLs — add each callback you may use:
#     http://localhost:3000/auth/callback
#     http://localhost:3002/auth/callback
#     …your deployed origin…/auth/callback
#
# Confirmation links use the SAME host/port as signup (from the incoming request).
# Easiest pure-local testing: Dashboard → Providers → Email → disable “Confirm email”.

# Google Maps. Used for the map on an activity via the Maps Embed API, which is free
# with unlimited requests (https://developers.google.com/maps/documentation/embed/usage-and-billing).
# Without this the app falls back to a Leaflet + OpenStreetMap map.
#
# RESTRICT THIS KEY in Google Cloud Console before using it. The Embed API puts the key
# in the iframe URL, so it is visible to anyone loading the page:
#   Application restrictions → HTTP referrers → https://runsheet-six.vercel.app/*
#                                               http://localhost:3000/*
#   API restrictions        → Maps Embed API only
# An unrestricted key can be lifted from the page and spent against billed Maps SKUs.
# GOOGLE_MAPS_API_KEY=
#
# Places Photos (location photography) is a separate, *billed* SKU — Enterprise tier,
# 1,000 free calls/month. Not wired up; the UI renders trip_ideas.image_url and
# slots.preview_image_url whenever they are set.
